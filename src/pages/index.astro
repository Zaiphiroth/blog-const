---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

// Obtiene todas las tareas/entradas del blog ordenadas si es necesario
const posts = await getCollection('blog');
const titles = [
    {
        ref: "blog/preambulo/",
        text: "Tarea 1: Preámbulo y Estructura de la Constitución de 1991"
    },
    {
        ref: "blog/esfera/",
        text: "Tarea 2: Esfera Pública y Esfera Privada"
    },
    {
        ref: "blog/ambiente/",
        text: "Tarea 3: Medioambiente, Museo Nacional y Chiribiquete"
    },
    {
        ref: "blog/musica/",
        text: "Tarea 4: Música y más en Colombia (Joe Arroyo y Octavio Mesa)"

    },
    {
        ref: "blog/literatura/",
        text: 'Tarea 5: Literatura ("Espuma y nada más" y Mario Mendoza)'
    },
    {
        ref: "blog/mecanismos/",
        text: "Tarea 6: Mecanismos de Protección de Derechos Humanos"
    },
    {
        ref: "blog/animales/",
        text: "Tarea 7: Los animales y la pólvora"
    },
    {
        ref: "blog/lideres/",
        text: "Tarea 8: Liderazgos positivos y negativos"
    },
    {
        ref: "blog/turismo/",
        text: "Tarea 9: Turismo: presente y futuro"
    },
    {
        ref: "blog/conclusión/",
        text: "Tarea 10: Balance final: a modo de reflexión"
    }
    
]
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main>
            <h2>Bitácora de Reflexiones y Tareas</h2>
            <p>
              Estas son mis tareas para Constitución política.
			  El uso de IA fue como estilografo y para parcialmente la creación de la pagina
			  espero sea de su total agrado.
            </p>

            <h2>Índice de Tareas</h2>
            <ul>
                {
                    titles.map(u => <li><a href={`${import.meta.env.BASE_URL}/${u.ref}`}>{u.text}</a></li>)
                }
            </ul>

            <hr />

        </main>
        <Footer />
    </body>
</html>